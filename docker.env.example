# Copy this file to ".env" in the project root (next to docker-compose.yml).
# Docker Compose reads it automatically to fill in the ${VARS} used inside
# docker-compose.yml. This is NOT the application's own .env.
#
# The application's own .env (WEB_PASSWORD, WEB_HOST, ...) lives inside
# TIPPYBOT_DATA_ROOT/config/.env once the container has started -- see
# .env.example and docs/docker.md.

# Required. Absolute host path where ALL persistent data is stored, outside
# the project directory: config/, data/, auth_cache/, logs/.
TIPPYBOT_DATA_ROOT=/srv/tippybot

# Optional. Run the container as this host UID/GID instead of the default
# 1000:1000, so files under TIPPYBOT_DATA_ROOT are owned by a specific user.
# Match your own account (`id -u` / `id -g`) if you created TIPPYBOT_DATA_ROOT
# yourself -- see docs/docker.md for why this matters.
# PUID=1000
# PGID=1000
