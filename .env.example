# Bot instance configuration (host, port, username, auth, admins, ...) lives in
# bots.config.json, not here -- copy bots.config.example.json to bots.config.json
# and edit it. See docs/multi-instance.md.
# Optional: override the path to the instance config file.
# BOTS_CONFIG_PATH=./bots.config.json

# Web dashboard and log viewer (enabled by default). Use 127.0.0.1 for local-only access.
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=3000
# Set true only when users access TippyBot exclusively through HTTPS.
WEB_SECURE_COOKIES=false
# Full dashboard snapshot broadcast interval (milliseconds).
WEB_DASHBOARD_INTERVAL_MS=2000

# Optional. When omitted, a strong password is generated once and atomically
# appended to .env. The generated password is never sent through logging.
# WEB_PASSWORD=replace-with-a-long-random-password

# Per-IP failed-login protection.
WEB_LOGIN_MAX_ATTEMPTS=5
WEB_LOGIN_LOCKOUT_MS=900000

# Per-instance log storage warning. Rotation/gzip do not delete old logs.
LOG_DISK_WARN_MB=500
LOG_DISK_CHECK_INTERVAL_MS=3600000
