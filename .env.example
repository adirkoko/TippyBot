# Bot instance configuration (host, port, username, auth, admins, ...) lives in
# bots.config.json, not here -- copy bots.config.example.json to bots.config.json
# and edit it. See docs/multi-instance.md.
#
# This file is for settings that apply to the whole process rather than to a
# single bot instance. There's nothing here yet.

# Optional: override the path to the instance config file.
# BOTS_CONFIG_PATH=./bots.config.json
